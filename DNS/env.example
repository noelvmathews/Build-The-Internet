# acm-dns configuration. Load with:  set -a; source .env; set +a
# Address acm-dns itself listens on (0.0.0.0 = all interfaces)
ACM_DNS_HOST=0.0.0.0
ACM_DNS_PORT=8000

# Registration lifetime. 0 = entries never expire (default).
# If set (e.g. 30s), clients must re-POST /register more often than this.
ACM_DNS_TTL=0

# Optional comma-separated allowlist; blocks rogue names (403). Empty = allow any valid name.
# ACM_DNS_ALLOWED_DOMAINS=acm-db,acm-server,acm-app

# Optional CORS origin so a browser app (acm-app) can call acm-dns directly. Empty = off.
# ACM_DNS_CORS_ORIGIN=*

ACM_DNS_LOG_LEVEL=info    # debug|info|warn|error
ACM_DNS_LOG_FORMAT=json   # json|text
